# ---- Next.js (local file: .env.local, created by `npx convex dev`) ----
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# ---- Convex environment variables (set in the Convex dashboard or `npx convex env set NAME value`) ----
# Never put real values in git.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_NUMBER=+15550100000
SELLER_PHONE=+15550100002          # distributor rep's phone for the demo (must be verified on a trial account)
XAI_API_KEY=xai-xxxxxxxx
CONSENT_AUDIO_URL=https://example.com/consent.mp3   # optional; falls back to <Say> with the consent script
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx  # Person 2
APIFY_TOKEN=apify_api_xxxxxxxx     # Person 2

# Order summaries and replies over WhatsApp instead of SMS (avoids US A2P 10DLC registration)
# MESSAGE_CHANNEL=whatsapp          # whatsapp | sms (default sms)
# TWILIO_WHATSAPP_NUMBER=+14155238886   # Twilio WhatsApp sandbox number (default)

# Optional knobs
# STT_PROVIDER=xai                  # xai (default) | openai (timebox fallback)
# OPENAI_API_KEY=sk-...             # only if STT_PROVIDER=openai
# SMS_SIMULATE=1                    # never hit Twilio; every outbound SMS is stored as "simulated"
# TWILIO_WEBHOOK_BASE_URL=https://xxx.convex.site   # only if signature validation fails behind a proxy
# TWILIO_SKIP_SIGNATURE_VALIDATION=1                # local testing with curl only. NEVER in the demo deployment.
